include *.md
include LICENSE
include examples/hello.bas examples/fibonacci.bas examples/subroutines.bas
include examples/data.bas examples/input.bas examples/while.bas examples/types.bas
include examples/logic_*.bas examples/triangle_*.bas examples/calc_*.bas
